<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LuaTools</AssemblyName>
    <AssemblyTitle>LuaTools</AssemblyTitle>
    <Product>LuaTools</Product>
    <Version>1.4.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Custom Main initializes culture and the isolated single-instance identity before WPF. -->
    <StartupObject>LuaToolsGui.Program</StartupObject>
  </PropertyGroup>

  <!-- UseWindowsForms (for the tray NotifyIcon) injects WinForms into the implicit global usings, which
       collides with WPF types (Application, UserControl, DragEventArgs…). We reference WinForms fully
       qualified, so strip those implicit usings to keep WPF unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Let the test project reach internal members (e.g. Program.MatchOsLanguage). -->
  <ItemGroup>
    <InternalsVisibleTo Include="LuaToolsGui.Tests" />
  </ItemGroup>

  <!-- Make App.xaml a Page so the SDK doesn't auto-generate a Main that conflicts with Program.Main -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Embed icon.ico as a resource so the Window Icon="icon.ico" can resolve it at runtime -->
  <ItemGroup>
    <Resource Include="icon.ico" />
    <EmbeddedResource Include="Resources\release-signing-public.pem" LogicalName="LuaToolsGui.release-signing-public.pem" />
    <EmbeddedResource Include="Plugin\steam-plugin.js" LogicalName="LuaToolsGui.Plugin.steam-plugin.js" />
    <EmbeddedResource Include="Plugin\steam-plugin.css" LogicalName="LuaToolsGui.Plugin.steam-plugin.css" />
    <EmbeddedResource Include="Services\Cabinet\Engine\cabinet-32.png" LogicalName="Cabinet.Icon32" />
    <EmbeddedResource Include="..\..\artifacts\plugin-loader\winmm.dll" LogicalName="LuaToolsGui.Plugin.winmm.dll" Condition="Exists('..\..\artifacts\plugin-loader\winmm.dll')" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\SECURITY.md" Link="SECURITY.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\DEPENDENCY_TRUST.md" Link="DEPENDENCY_TRUST.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The source-owned plugin is bundled. Other executable dependencies remain separately gated. -->


  <!-- Localization RESX. We hand-maintain Strings.Designer.cs (works under dotnet watch), so disable the
       SDK's auto-generated designer to avoid a duplicate Strings class. French builds a satellite assembly. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings*.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
