<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:LuaToolsGui.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LuaToolsGui.Views.CabinetView" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="#10FFFFFF"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#06FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WideRow">
            <Button Style="{StaticResource RowButton}" Command="{Binding OpenGameCommand}" AutomationProperties.Name="{Binding OpenLabel}">
                <Button.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenGameCommand}"/>
                </Button.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="92" Height="43" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="#2e3440"/>
                            </Border.Background>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#224ade80" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasPlayingBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#4ade80" Text="{Binding PlayingBadge}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#22fbbf24" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasPendingBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#fbbf24" Text="{Binding PendingBadge}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#10FFFFFF" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasSchemaBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_NoSchema}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding Unlocked, Mode=OneWay}"/>
                            <Run Foreground="#9ca3af" Text="{Binding Total, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Height="4" Margin="0,5,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Hours}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Column="3" Text="{Binding LastSync}" Foreground="#9ca3af" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="CompactRow">
            <Button Style="{StaticResource RowButton}" Command="{Binding OpenGameCommand}" AutomationProperties.Name="{Binding OpenLabel}">
                <Button.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenGameCommand}"/>
                </Button.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="30" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="#2e3440"/>
                            </Border.Background>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#224ade80" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasPlayingBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#4ade80" Text="{Binding PlayingBadge}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#22fbbf24" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasPendingBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#fbbf24" Text="{Binding PendingBadge}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#10FFFFFF" CornerRadius="9" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Left" Visibility="{Binding HasSchemaBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_NoSchema}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding Unlocked, Mode=OneWay}"/>
                            <Run Foreground="#9ca3af" Text="{Binding Total, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Height="4" Margin="0,5,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Hours}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Cabinet_Title}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6b7280" TextWrapping="Wrap" Text="{x:Static res:Strings.Cabinet_Subtitle}"/>
                </StackPanel>
                <ui:Button VerticalAlignment="Top" HorizontalAlignment="Left" Appearance="Primary" Command="{Binding SyncNowCommand}" Content="{Binding SyncLabel}" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="0,10,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
            <WrapPanel Margin="0,14,0,0" Visibility="{Binding ShowChips, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#4ade80" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Text="{Binding TrackingLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding SteamColor}" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Text="{Binding SteamLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#4ade80" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Text="{Binding PlayingLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding CloudColor}" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Text="{Binding CloudLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#fbbf24" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Text="{x:Static res:Strings.Cabinet_Paused}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <TextBlock Foreground="#fbbf24" Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="14,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_Game}"/>
                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_Achievements}"/>
                            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_Played}"/>
                            <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_LastSync}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource WideRow}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource CompactRow}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- Cabinet save backups (format-2 archives); separate from CloudRedirect storage. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14,12" Visibility="{Binding ShowSaves, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.CabinetSaves_Title}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Text="{x:Static res:Strings.CabinetSaves_Subtitle}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding RescanSavesCommand}" Content="{x:Static res:Strings.CabinetSaves_Rescan}" Icon="{ui:SymbolIcon ArrowClockwise24}"/>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="#fbbf24" Text="{Binding SaveError}" TextWrapping="Wrap" Visibility="{Binding SaveError, Converter={StaticResource NullToCollapsed}}"/>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Text="{x:Static res:Strings.CabinetSaves_Empty}" Visibility="{Binding NoSaveGames, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SaveGames}" Visibility="{Binding HasSaveGames, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="#10FFFFFF" Padding="0,10">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="9" Padding="7,1" Background="#14FFFFFF">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="11" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#cbd5e1" TextWrapping="Wrap" Text="{Binding Locations}" Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}"/>
                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock FontSize="11" Foreground="#9ca3af" Margin="0,0,14,0" Text="{Binding Totals}"/>
                                                <TextBlock FontSize="11" Foreground="#9ca3af" Margin="0,0,14,0" Text="{Binding CloudTotals}" Visibility="{Binding HasCloud, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock FontSize="11" Foreground="#9ca3af" Margin="0,0,14,0" Text="{Binding LastUpload}"/>
                                                <TextBlock FontSize="11" Foreground="#9ca3af" Margin="0,0,14,0" Text="{Binding LastDownload}"/>
                                                <TextBlock FontSize="11" Foreground="#9ca3af" Text="{Binding OverrideText}" Visibility="{Binding OverrideText, Converter={StaticResource NullToCollapsed}}"/>
                                            </WrapPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280" TextWrapping="Wrap" Text="{Binding Notes}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <ui:Button Margin="0,0,8,4" Appearance="Primary" Content="{x:Static res:Strings.CabinetSaves_KeepLocal}" Command="{Binding KeepLocalCommand}" Visibility="{Binding ShowConflictActions, Converter={StaticResource BoolToVis}}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{x:Static res:Strings.CabinetSaves_UseCloud}" Command="{Binding RestoreCommand}" Visibility="{Binding ShowConflictActions, Converter={StaticResource BoolToVis}}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{x:Static res:Strings.CabinetSaves_Restore}" Command="{Binding RestoreCommand}" Visibility="{Binding ShowRestore, Converter={StaticResource BoolToVis}}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{x:Static res:Strings.CabinetSaves_EditLocation}" Command="{Binding EditLocationCommand}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{x:Static res:Strings.CabinetSaves_ResetLocation}" Command="{Binding ResetLocationCommand}" Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{Binding ToggleLabel}" Command="{Binding ToggleSyncCommand}"/>
                                                <ui:Button Margin="0,0,8,4" Content="{x:Static res:Strings.CabinetSaves_DeleteCloud}" Command="{Binding DeleteCloudCommand}" Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#6b7280" TextWrapping="Wrap" Text="{Binding SaveAttribution}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="24,40" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static res:Strings.Cabinet_EmptyTitle}"/>
                        <TextBlock Margin="0,6,0,14" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_EmptyHint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="24,40" Visibility="{Binding IsOff, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static res:Strings.Cabinet_OffTitle}"/>
                        <TextBlock Margin="0,6,0,14" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Cabinet_OffHint}"/>
                        <ui:Button HorizontalAlignment="Center" Appearance="Primary" Command="{Binding TurnOnCommand}" Content="{x:Static res:Strings.Cabinet_TurnOn}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

